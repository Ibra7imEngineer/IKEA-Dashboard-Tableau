      <column caption='profitay' datatype='string' name='[Calculation_2942077575233538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &apos;Profit&apos; ELSEIF [Profit] = 0 THEN &apos;preakeven&apos; ELSE &apos;loss&apos; END' />
      </column>
      <column caption='sales AVG' datatype='string' name='[Calculation_2942077582630915]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; WINDOW_AVG(SUM([Sales])) THEN &apos;Above AVG&apos; ELSE &apos;Beiow AVG&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Target' datatype='string' name='[Calculation_2942077585674244]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; 200000 THEN &apos;Got Target&apos; ELSEIF SUM([Sales]) = 200000 THEN &apos;On Target&apos; ELSE &apos;Below Target&apos;END' />
      </column>
      <column caption='A V G     O  V' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2942077605740549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
